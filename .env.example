# Database Configuration for SIH26002 - NER Logistics
# Copy this file to .env or backend/.env and replace with your actual PostgreSQL credentials:
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/ner_logistics

# AI Chat Assistant — Google Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
